# Generate with: openssl rand -hex 32
SQLITE_KEY=replace_with_64_hex_chars

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars

# Admin account (only used on first startup when no users exist)
ADMIN_USER=admin
ADMIN_PASS=changeme

# BaoStock microservice URL (default: http://localhost:8888)
BAOSTOCK_URL=http://localhost:8888
