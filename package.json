{
  "name": "stocktrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:test": "cd server && npm run test",
    "build:full": "npm run build && npm run server:build && node -e \"require('fs').cpSync('dist','server/dist/public',{recursive:true})\"",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
